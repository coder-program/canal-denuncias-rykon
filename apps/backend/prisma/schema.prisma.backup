// ====================================
// PRISMA SCHEMA - PostgreSQL
// Canal de Denúncias Corporativo
// ====================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// ENUMS
// ====================================
enum UserRole {
  PUBLIC          // Acesso público (criar denúncia)
  REPORTER        // Denunciante autenticado (acompanhar próprias denúncias)
  INVESTIGATOR    // Investigador do comitê
  ADMIN           // Administrador do sistema
  AUDITOR         // Auditor (leitura apenas)
}

enum ComplaintStatus {
  PENDING         // Aguardando triagem
  IN_PROGRESS     // Em investigação
  UNDER_REVIEW    // Em análise
  RESOLVED        // Resolvida
  DISMISSED       // Arquivada sem procedência
  ESCALATED       // Escalada para instância superior
}

enum ComplaintType {
  HARASSMENT      // Assédio
  DISCRIMINATION  // Discriminação
  FRAUD           // Fraude
  CORRUPTION      // Corrupção
  SAFETY          // Segurança
  ETHICS          // Ética
  OTHER           // Outros
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  DOWNLOAD
  BLOCK
  UNBLOCK
}

enum NotificationType {
  COMPLAINT_CREATED       // Nova denúncia criada
  COMPLAINT_ASSIGNED      // Denúncia atribuída a investigador
  COMPLAINT_STATUS_CHANGED // Status da denúncia alterado
  COMPLAINT_COMMENT       // Novo comentário na denúncia
  ATTACHMENT_UPLOADED     // Novo anexo adicionado
  DOSSIER_GENERATED       // Dossiê gerado
  SYSTEM_ALERT            // Alerta do sistema
  DEADLINE_REMINDER       // Lembrete de prazo
}

enum NotificationChannel {
  EMAIL           // Enviar por email
  IN_APP          // Notificação in-app
  WEBSOCKET       // Real-time via WebSocket
}

// ====================================
// USERS & AUTHENTICATION
// ====================================
model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String            @map("password_hash")
  fullName          String?           @map("full_name") // Encrypted se sensível
  role              UserRole          @default(PUBLIC)
  isActive          Boolean           @default(true) @map("is_active")
  isBlocked         Boolean           @default(false) @map("is_blocked")
  blockedReason     String?           @map("blocked_reason")
  blockedAt         DateTime?         @map("blocked_at")
  blockedBy         String?           @map("blocked_by")
  lastLoginAt       DateTime?         @map("last_login_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relações
  refreshTokens         RefreshToken[]
  complaintsCreated     Complaint[]       @relation("ComplaintCreator")
  assignedComplaints    Complaint[]       @relation("ComplaintInvestigator")
  auditLogs             AuditLog[]
  notifications         Notification[]
  dossiersCreated       Dossier[]
  attachmentsUploaded   Attachment[]      @relation("AttachmentUploader")
  attachmentsDeleted    Attachment[]      @relation("AttachmentDeleter")
  userPreferences       UserPreferences?

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String   @map("user_id")
  expiresAt   DateTime @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ====================================
// COMPLAINTS (Denúncias)
// ====================================
model Complaint {
  id                String            @id @default(uuid())
  protocol          String            @unique // Código único de protocolo
  isAnonymous       Boolean           @default(false) @map("is_anonymous")
  reporterEmail     String?           @map("reporter_email") // Encrypted se anônimo
  reporterPhone     String?           @map("reporter_phone") // Encrypted
  type              ComplaintType
  priority          ComplaintPriority @default(MEDIUM)
  status            ComplaintStatus   @default(PENDING)
  title             String
  description       String            @db.Text
  location          String?           // Local do incidente
  incidentDate      DateTime?         @map("incident_date")
  involvedPeople    String[]          @map("involved_people") // Lista de nomes/IDs (encrypted)
  witnesses         String[]          @default([]) // Testemunhas
  metadata          Json?             // Campo flexível para dados adicionais
  
  // Investigação
  investigatorId    String?           @map("investigator_id")
  investigationNotes String?          @db.Text @map("investigation_notes")
  resolutionNotes   String?           @db.Text @map("resolution_notes")
  resolvedAt        DateTime?         @map("resolved_at")
  
  // Auditoria
  createdBy         String?           @map("created_by") // NULL se anônimo
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Hash para verificação de integridade
  integrityHash     String?           @map("integrity_hash")

  // Relações
  creator           User?             @relation("ComplaintCreator", fields: [createdBy], references: [id])
  investigator      User?             @relation("ComplaintInvestigator", fields: [investigatorId], references: [id])
  attachments       Attachment[]
  dossiers          Dossier[]
  statusHistory     ComplaintStatusHistory[]

  @@index([protocol])
  @@index([status])
  @@index([createdAt])
  @@index([investigatorId])
  @@map("complaints")
}

// ====================================
// COMPLAINT STATUS HISTORY (Histórico de Status)
// ====================================
model ComplaintStatusHistory {
  id           String          @id @default(uuid())
  complaintId  String          @map("complaint_id")
  previousStatus ComplaintStatus? @map("previous_status")
  newStatus    ComplaintStatus @map("new_status")
  changedBy    String?         @map("changed_by")
  reason       String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_status_history")
}

// ====================================
// ATTACHMENTS (Anexos de Evidência)
// ====================================
model Attachment {
  id          String    @id @default(uuid())
  complaintId String    @map("complaint_id")
  filename    String    // Nome original do arquivo
  mimeType    String    @map("mime_type")
  size        Int       // Tamanho em bytes
  s3Key       String    @map("s3_key") // Chave do arquivo no S3
  s3Bucket    String    @map("s3_bucket")
  sha256Hash  String    @map("sha256_hash") // SHA256 para integridade
  uploadedBy  String    @map("uploaded_by")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  
  // Soft Delete
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  
  // Relações
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploader    User      @relation("AttachmentUploader", fields: [uploadedBy], references: [id])
  deleter     User?     @relation("AttachmentDeleter", fields: [deletedBy], references: [id])

  @@index([complaintId])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@map("attachments")
}

// ====================================
// DOSSIERS (Dossiês de Investigação)
// ====================================
model Dossier {
  id              String    @id @default(uuid())
  complaintId     String    @map("complaint_id")
  title           String
  summary         String    @db.Text
  generatedBy     String    @map("generated_by")
  generatedAt     DateTime  @default(now()) @map("generated_at")
  s3PdfKey        String?   @map("s3_pdf_key") // PDF gerado
  s3ZipKey        String?   @map("s3_zip_key") // ZIP com todas evidências
  
  createdBy       User      @relation(fields: [generatedBy], references: [id])
  complaint       Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("dossiers")
}

// ====================================
// AUDIT LOGS (Logs de Auditoria Imutáveis)
// ====================================
model AuditLog {
  id          String      @id @default(uuid())
  userId      String?     @map("user_id")
  action      AuditAction
  resource    String      // Ex: "complaint", "user", "dossier"
  resourceId  String?     @map("resource_id")
  details     Json?       // Detalhes da ação
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  timestamp   DateTime    @default(now())
  
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ====================================
// SYSTEM SETTINGS (Configurações do Sistema)
// ====================================
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("system_settings")
}

// ====================================
// CORPORATE DOCUMENTS (Documentos Corporativos)
// ====================================
model CorporateDocument {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  s3Key       String   @map("s3_key")
  s3Bucket    String   @map("s3_bucket")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  isActive    Boolean  @default(true) @map("is_active")

  @@map("corporate_documents")
}

// ====================================
// NOTIFICATIONS & PREFERENCES
// ====================================
model Notification {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  type            NotificationType
  channel         NotificationChannel
  title           String
  message         String             @db.Text
  data            Json?              // Dados adicionais (JSON)
  relatedId       String?            @map("related_id") // ID da denúncia, anexo, etc.
  relatedType     String?            @map("related_type") // "complaint", "attachment", etc.
  isRead          Boolean            @default(false) @map("is_read")
  readAt          DateTime?          @map("read_at")
  sentAt          DateTime?          @map("sent_at")
  emailSent       Boolean            @default(false) @map("email_sent")
  emailSentAt     DateTime?          @map("email_sent_at")
  emailError      String?            @map("email_error")
  createdAt       DateTime           @default(now()) @map("created_at")

  // Relações
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model UserPreferences {
  id                          String    @id @default(uuid())
  userId                      String    @unique @map("user_id")
  
  // Preferências de Email
  emailNotifications          Boolean   @default(true) @map("email_notifications")
  emailComplaintCreated       Boolean   @default(true) @map("email_complaint_created")
  emailComplaintAssigned      Boolean   @default(true) @map("email_complaint_assigned")
  emailComplaintStatusChanged Boolean   @default(true) @map("email_complaint_status_changed")
  emailComplaintComment       Boolean   @default(true) @map("email_complaint_comment")
  emailAttachmentUploaded     Boolean   @default(true) @map("email_attachment_uploaded")
  emailDossierGenerated       Boolean   @default(true) @map("email_dossier_generated")
  emailSystemAlert            Boolean   @default(true) @map("email_system_alert")
  emailDeadlineReminder       Boolean   @default(true) @map("email_deadline_reminder")
  
  // Preferências In-App
  inAppNotifications          Boolean   @default(true) @map("in_app_notifications")
  inAppComplaintCreated       Boolean   @default(true) @map("in_app_complaint_created")
  inAppComplaintAssigned      Boolean   @default(true) @map("in_app_complaint_assigned")
  inAppComplaintStatusChanged Boolean   @default(true) @map("in_app_complaint_status_changed")
  inAppComplaintComment       Boolean   @default(true) @map("in_app_complaint_comment")
  inAppAttachmentUploaded     Boolean   @default(true) @map("in_app_attachment_uploaded")
  inAppDossierGenerated       Boolean   @default(true) @map("in_app_dossier_generated")
  inAppSystemAlert            Boolean   @default(true) @map("in_app_system_alert")
  inAppDeadlineReminder       Boolean   @default(true) @map("in_app_deadline_reminder")
  
  // Preferências WebSocket (Real-time)
  websocketNotifications      Boolean   @default(true) @map("websocket_notifications")
  
  // Configurações Gerais
  notificationSound           Boolean   @default(true) @map("notification_sound")
  emailDigest                 Boolean   @default(false) @map("email_digest") // Receber resumo diário
  emailDigestTime             String?   @default("09:00") @map("email_digest_time") // Horário do resumo
  
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  // Relações
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
