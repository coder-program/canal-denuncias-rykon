{
  "name": "canal-denuncia-corporativo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema completo de Canal de Denúncias Corporativo - Produção Grade",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml}\"",
    "audit": "npm audit --workspaces --audit-level=high",
    "audit:fix": "npm audit fix --workspaces",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "cd apps/backend && npm run prisma:migrate",
    "db:seed": "cd apps/backend && npm run prisma:seed",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "prepare": "husky",
    "postinstall": "node -e \"const fs=require('fs');const p='apps/frontend/node_modules/@eslint/eslintrc';if(fs.existsSync(p)&&!fs.existsSync(p+'/package.json')){fs.rmSync(p,{recursive:true,force:true});}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "next": "15.5.5",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript-eslint/utils": "^8",
    "@canal-denuncia/backend": {
      "@typescript-eslint/eslint-plugin": "8.69.0",
      "@typescript-eslint/parser": "8.69.0"
    }
  },
  "lint-staged": {
    "apps/backend/src/**/*.ts": [
      "prettier --write"
    ],
    "apps/frontend/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sua-org/canal-denuncia-corporativo"
  },
  "author": "Time de Engenharia - Compliance Corp",
  "license": "PROPRIETARY"
}
