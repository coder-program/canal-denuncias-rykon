{
  "name": "canal-denuncia-corporativo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema completo de Canal de Denúncias Corporativo - Produção Grade",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "cd apps/backend && npm run prisma:migrate",
    "db:seed": "cd apps/backend && npm run prisma:seed",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sua-org/canal-denuncia-corporativo"
  },
  "author": "Time de Engenharia - Compliance Corp",
  "license": "PROPRIETARY"
}
