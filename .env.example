# ====================================
# Variáveis usadas por docker-compose.prod.yml
# Copie para ".env" na raiz do projeto e preencha com valores reais/secrets
# (nunca commitar o ".env" real — já coberto pelo .gitignore)
# ====================================

# PostgreSQL
POSTGRES_USER=denuncia_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=canal_denuncia

# MongoDB
MONGO_USER=denuncia_user
MONGO_PASSWORD=change-me-strong-password
MONGO_DATABASE=canal_denuncia_docs

# RabbitMQ
RABBITMQ_USER=denuncia_user
RABBITMQ_PASSWORD=change-me-strong-password

# JWT / Criptografia
JWT_SECRET=change-me-minimum-32-chars
JWT_REFRESH_SECRET=change-me-minimum-32-chars
ENCRYPTION_KEY=change-me-32-char-encryption-key

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=canal-denuncia-attachments

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# URLs
# CORS_ORIGIN aceita múltiplas origens separadas por vírgula, ex.:
# CORS_ORIGIN=https://app.suaempresa.com,https://seu-projeto.vercel.app
CORS_ORIGIN=https://app.suaempresa.com
FRONTEND_URL=https://app.suaempresa.com
